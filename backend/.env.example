# Copy to backend/.env for running the API outside Docker. Never commit .env.
PORT=3001
DATABASE_URL=postgres://mollookup:mollookup@localhost:5432/mollookup
# PubChem asks for <=5 req/s; this client caps at 4.
PUBCHEM_RPS=4
# Optional: add a contact address so PubChem can reach you, e.g. "MolLookUp/0.1 (you@example.com)"
PUBCHEM_USER_AGENT=MolLookUp/0.1 (portfolio project)
# RapidAPI key for the daily-fact endpoint. Leave empty to disable /api/fact.
RAPIDAPI_KEY=
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
CACHE_ONLY=false
